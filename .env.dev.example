# ============================================================
#  DEV preset — любой ноутбук/ПК (в т.ч. без подходящей GPU).
#  Цель: пайплайн просто поднимается, тестируется ЛОГИКА.
#  Ollama тут может считать на CPU (медленнее) — это нормально.
#
#  Скопируй в .env:   copy .env.dev.example .env
# ============================================================

# --- LLM (Ollama, нативно на хосте) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.8
OLLAMA_KEEP_ALIVE=10m
# Лимит длины ответа (токены). Меньше = лаконичнее. «Объясни» — просторнее.
REPLY_MAX_TOKENS_CONVERSATION=80
REPLY_MAX_TOKENS_EXPLAIN=320

# --- STT (faster-whisper, CPU) ---
WHISPER_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_CPU_THREADS=4

# --- TTS ---
# kokoro = естественный английский (CPU/onnx); русский всё равно через Piper.
# piper  = Piper на оба языка (легче, но синтетичнее).
TTS_BACKEND=kokoro
# Английский голос Kokoro (список: hexgrad/Kokoro-82M -> VOICES.md).
KOKORO_VOICE=af_heart
# Английский голос Piper (используется, если TTS_BACKEND=piper).
TTS_VOICE=en_US-lessac-medium
# Русский голос Piper (всегда, когда ответ по-русски).
TTS_VOICE_RU=ru_RU-irina-medium

# --- Поведение приложения ---
DEFAULT_INPUT_LANG=en
DEFAULT_MODE=conversation
