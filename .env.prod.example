# ============================================================
#  PROD preset — целевой ПК (GTX 1050 Ti, 4 ГБ VRAM, 16 ГБ RAM).
#  На GPU — ТОЛЬКО LLM. STT/TTS/VAD всегда на CPU.
#  Функционал тот же, что в dev — отличаются лишь модель и скорость.
#
#  Скопируй в .env:   copy .env.prod.example .env
# ============================================================

# --- LLM (Ollama, нативно на хосте, берёт GPU) ---
OLLAMA_HOST=http://host.docker.internal:11434
# Современная нецензурированная 8B (Dolphin 3.0 на Llama-3.1, ~4.9 ГБ) — заметно умнее
# старой dolphin-mistral. На 1050 Ti (4 ГБ) идёт с частичной выгрузкой слоёв на CPU.
OLLAMA_MODEL=dolphin3:8b
# Контекст поменьше, чтобы влезть в 4 ГБ VRAM. Подними, если есть запас.
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.8
OLLAMA_KEEP_ALIVE=10m
# Лимит длины ответа (токены). Меньше = лаконичнее. «Объясни» — просторнее.
REPLY_MAX_TOKENS_CONVERSATION=80
REPLY_MAX_TOKENS_EXPLAIN=320
# Если ловишь VRAM OOM / модель уходит в CPU — ограничь число слоёв на GPU
# (у dolphin-mistral ~33 слоя). Оставь пустым для авто-детекта Ollama.
# OLLAMA_NUM_GPU=24

# --- STT (faster-whisper, CPU) ---
WHISPER_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_CPU_THREADS=4

# --- TTS ---
# kokoro = естественный английский (CPU/onnx); русский через Piper.
TTS_BACKEND=kokoro
KOKORO_VOICE=af_heart
TTS_VOICE=en_US-lessac-medium
TTS_VOICE_RU=ru_RU-irina-medium

# --- Поведение приложения ---
DEFAULT_INPUT_LANG=en
DEFAULT_MODE=conversation
